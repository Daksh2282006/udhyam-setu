# ==============================================================================
# UdyamSetu Platform - Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: The platform is designed to run out-of-the-box with ZERO mandatory .env keys!
# It uses native browser Web Speech STT/TTS and client-side analytical simulation engines.
# 
# The variables below are OPTIONAL for connecting external cloud AI and production APIs.

# Environment Mode
VITE_APP_ENV=development

# Backend API Endpoint (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Optional: Google Gemini API (for external cloud LLM fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Digital India Bhashini API (Govt. Vernacular Speech Engine)
VITE_BHASHINI_API_KEY=your_bhashini_api_key_here
VITE_BHASHINI_USER_ID=your_bhashini_user_id_here
